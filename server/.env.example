# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=3000
# 127.0.0.1 for local use. Containers must use 0.0.0.0.
HOST=127.0.0.1
# Public base URL of this server. Used to build the OIDC redirect URI.
APP_BASE_URL=http://localhost:3000

# --- Database ---
# Local development: embedded Postgres, no server needed.
#   pglite://./data          (persists to ./data)
#   memory://                (in-memory, for tests)
# Production: a normal Postgres connection string.
DATABASE_URL=pglite://./data

# --- University identity provider (OIDC) ---
# Leave blank to run without sign-in; /auth/* then returns 503 and says so.
# Microsoft Entra example:
#   OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# Google Workspace example:
#   OIDC_ISSUER=https://accounts.google.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email

# --- Development only ---
# Mounts a fake identity provider at /dev-idp so the full sign-in flow can be
# tried without a university. `npm run dev` turns this on for you. It is ignored
# whenever a real OIDC_ISSUER is set, and the server refuses to start with it
# enabled in production.
DEV_MOCK_IDP=false

# Insert two demo universities and some clubs at startup. Also ignored in
# production. `npm run dev` sets both of these for you.
SEED_DEMO_DATA=false

# --- Sessions ---
# At least 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
SESSION_COOKIE_NAME=atlas_session
SESSION_TTL_HOURS=12

# Set to true when served over HTTPS. Must be false on http://localhost.
COOKIE_SECURE=false
